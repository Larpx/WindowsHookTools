<Window x:Class="HookMonitor.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HookMonitor.GUI.ViewModels"
        xmlns:converters="clr-namespace:HookMonitor.GUI.Converters"
        Title="HookMonitor - 进程行为监控工具"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        TextElement.Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <converters:ThreatLevelToColorConverter x:Key="ThreatColorConverter"/>
        <converters:ThreatLevelToStringConverter x:Key="ThreatStringConverter"/>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="HookMonitor" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="进程行为监控" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="▶ 开始监控"
                        Command="{Binding StartCommand}"
                        Visibility="{Binding IsNotMonitoring, Converter={StaticResource BoolToVisConverter}}"
                        Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="■ 停止监控"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVisConverter}}"
                        Style="{DynamicResource DangerButton}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2" Content="清除记录"
                        Command="{Binding ClearCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{Binding StatusIndicatorColor}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 可疑进程列表 -->
            <Grid Grid.Column="0" Margin="16,12,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="可疑进程列表" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                <ListView Grid.Row="1" ItemsSource="{Binding SuspiciousProcesses}"
                          SelectedItem="{Binding SelectedProcess}"
                          Style="{DynamicResource ProcessListView}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="威胁" Width="60"
                                            DisplayMemberBinding="{Binding ThreatLevel, Converter={StaticResource ThreatStringConverter}}"/>
                            <GridViewColumn Header="评分" Width="50"
                                            DisplayMemberBinding="{Binding ThreatScore}"/>
                            <GridViewColumn Header="进程名" Width="120"
                                            DisplayMemberBinding="{Binding ProcessName}"/>
                            <GridViewColumn Header="PID" Width="60"
                                            DisplayMemberBinding="{Binding ProcessId}"/>
                            <GridViewColumn Header="频率/分" Width="70"
                                            DisplayMemberBinding="{Binding CallFrequency, StringFormat=F1}"/>
                            <GridViewColumn Header="检测原因" Width="200"
                                            DisplayMemberBinding="{Binding PrimaryDetectionReason}"/>
                            <GridViewColumn Header="文件路径" Width="250"
                                            DisplayMemberBinding="{Binding FilePath}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Background="{DynamicResource BorderColor}" Margin="0,12"/>

            <!-- 进程详情面板 -->
            <ScrollViewer Grid.Column="2" Margin="8,12,16,12" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedProcess}">
                    <TextBlock Text="进程详情" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <!-- 无选中状态 -->
                    <TextBlock Text="选择一个进程查看详情" Foreground="{DynamicResource TextTertiary}"
                               Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"
                               HorizontalAlignment="Center" Margin="0,40,0,0"/>

                    <!-- 详情内容 -->
                    <StackPanel Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}">
                        <!-- 威胁等级指示 -->
                        <Border Background="{Binding ThreatLevel, Converter={StaticResource ThreatColorConverter}}"
                                CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="威胁等级" FontSize="11" Foreground="White" Opacity="0.8"/>
                                <TextBlock Text="{Binding ThreatLevel, Converter={StaticResource ThreatStringConverter}}"
                                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding ThreatScore, StringFormat='评分: {0}/100'}"
                                           FontSize="12" Foreground="White" Opacity="0.9"/>
                            </StackPanel>
                        </Border>

                        <!-- 基本信息 -->
                        <TextBlock Text="基本信息" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <Border Style="{DynamicResource DetailCard}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="进程名称" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding ProcessName}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="PID" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding ProcessId}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="会话ID" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding SessionId}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="架构" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Architecture}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="启动时间" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 文件信息 -->
                        <TextBlock Text="文件信息" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <Border Style="{DynamicResource DetailCard}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="文件路径" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding FilePath}" Style="{DynamicResource DetailValue}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="命令行" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding CommandLine}" Style="{DynamicResource DetailValue}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="公司" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Company}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="描述" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Description}" Style="{DynamicResource DetailValue}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="版本" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding FileVersion}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 进程关系 -->
                        <TextBlock Text="进程关系" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <Border Style="{DynamicResource DetailCard}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="父进程" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Style="{DynamicResource DetailValue}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} (PID: {1})">
                                                <Binding Path="ParentProcessName"/>
                                                <Binding Path="ParentProcessId"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="是否服务" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding IsService}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="服务名" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding ServiceName}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="受保护" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding IsProtected}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 检测信息 -->
                        <TextBlock Text="检测信息" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <Border Style="{DynamicResource DetailCard}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="首次检测" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding FirstDetected, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="最近检测" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding LastDetected, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                                <StackPanel Style="{DynamicResource DetailRow}">
                                    <TextBlock Text="调用频率" Style="{DynamicResource DetailLabel}"/>
                                    <TextBlock Text="{Binding CallFrequency, StringFormat='{}{0:F1} 次/分'}" Style="{DynamicResource DetailValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 检测原因 -->
                        <TextBlock Text="检测原因" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding DetectionReasons}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}"
                                            CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource ToolbarBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusSummary}"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ScanCountText}"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock Grid.Column="2" Text="{Binding ApiCallCountText}"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock Grid.Column="4" Text="Ring3 User-Mode Monitor | HVCI Compatible"
                           FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
